#version 460
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) uniform sampler2D samplerInput;
layout(set = 0, binding = 1) uniform sampler2D samplerDepth;
layout(set = 0, binding = 2) uniform sampler2D samplerNormal;
layout(set = 0, binding = 3) uniform sampler2D samplerMaterial;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outGraph;

layout(push_constant) uniform Constants {
    int stepSize;
    int isRTAO;
} pc;

float Luminance(vec3 color) {
    return dot(color, vec3(0.299, 0.587, 0.114));
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    vec2 size = vec2(imageSize(outGraph));
    if (pixelCoord.x >= size.x || pixelCoord.y >= size.y) return;

    vec2 uv = (vec2(pixelCoord) + 0.5) / size;
    float centerDepth = texture(samplerDepth, uv).r;
    if (centerDepth >= 0.9999) {
        imageStore(outGraph, pixelCoord, vec4(0.0));
        return;
    }

    vec3 centerNormal = texture(samplerNormal, uv).xyz;
    vec4 centerData = texture(samplerInput, uv);
    vec3 centerColor = centerData.rgb;
    float centerVariance = centerData.a;

    // Edge-Stopping Tuning Variables
    float phiDepth  = 1.0;
    float phiNormal = 128.0;
    float phiLuma   = 2.0;

    // A-Trous 5x5 Weights
    float weights[3] = float[](3.0/8.0, 1.0/4.0, 1.0/16.0);

    vec3  sumColor    = centerColor * weights[0] * weights[0];
    float sumVariance = centerVariance * weights[0] * weights[0];
    float sumWeight   = weights[0] * weights[0];
    float centerLuma  = Luminance(centerColor);

    float centerStdDev = sqrt(max(centerVariance, 0.0));

    for (int y = -2; y <= 2; y++) {
        for (int x = -2; x <= 2; x++) {
            if (x == 0 && y == 0) continue;

            vec2 offsetUV = uv + (vec2(x, y) * pc.stepSize) / size;
            if (offsetUV.x < 0.0 || offsetUV.x > 1.0 || offsetUV.y < 0.0 || offsetUV.y > 1.0) continue;

            float sampleDepth = texture(samplerDepth, offsetUV).r;

            if (sampleDepth >= 0.9999) continue;

            vec3 sampleNormal = texture(samplerNormal, offsetUV).xyz;
            vec4 sampleData   = texture(samplerInput, offsetUV);
            float sampleLuma  = Luminance(sampleData.rgb);

            float wDepth  = exp(-abs(centerDepth - sampleDepth) * phiDepth);
            float wNormal = pow(max(dot(centerNormal, sampleNormal), 0.0), phiNormal);

            float wLuma = 1.0;
            if (pc.isRTAO == 0) {
  
                wLuma = exp(-abs(centerLuma - sampleLuma) / (phiLuma * centerStdDev + 1e-4));
            }

            float w = wDepth * wNormal * wLuma;
            float kernelWeight = weights[abs(x)] * weights[abs(y)];
            float finalWeight = w * kernelWeight;

            sumColor    += sampleData.rgb * finalWeight;
            sumVariance += sampleData.a * finalWeight * finalWeight;
            sumWeight   += finalWeight;
        }
    }

    if (sumWeight < 1e-6) {
        imageStore(outGraph, pixelCoord, vec4(centerColor, centerVariance));
        return;
    }

    vec3  finalColor    = sumColor / sumWeight;
    float finalVariance = sumVariance / (sumWeight * sumWeight);

    imageStore(outGraph, pixelCoord, vec4(finalColor, finalVariance));
}