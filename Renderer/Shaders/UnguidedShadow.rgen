#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_ray_query : require

#define PI 3.14159265359

layout(set = 1, binding = 0) uniform accelerationStructureEXT topLevelAS;

// CHANGED: Must be rgba16f to be compatible with SVGF history textures!
layout(set = 2, binding = 0, rgba16f) uniform writeonly image2D shadowMaskImage;

layout(set = 0, binding = 0) uniform CameraUBO {
    mat4 view;
    mat4 proj;
    mat4 invView;
    mat4 invProj;
    mat4 invViewProj;
    mat4 invProjUnjittered;
    mat4 viewProj;
    mat4 prevViewProj;
} camera;

struct PointLight {
    vec4 position;
    vec4 color;
};

struct DirectionalLight {
    vec4 direction;
    vec4 color;
};

layout(set = 0, binding = 3) readonly buffer LightData {
    DirectionalLight dirLight;
    uint pointLightCount;
    float padding[3];
    PointLight pointLights[];
} sceneLights;

layout(push_constant) uniform PushConsts {
    uint frameCount;
    uint spp;
} pc;
uint pcg_hash(uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rnd(inout uint seed) {
    seed = pcg_hash(seed);
    return float(seed) / 4294967296.0;
}

void main() {
    const ivec2 pixelCoord = ivec2(gl_LaunchIDEXT.xy);
    const vec2 resolution = vec2(gl_LaunchSizeEXT.xy);
    const vec2 pixelCenter = vec2(pixelCoord) + vec2(0.5);
    const vec2 UV = pixelCenter / resolution;
    
    vec2 ndc = UV * 2.0 - 1.0;


    vec4 originClip = vec4(ndc, 0.0, 1.0);
    vec4 targetClip = vec4(ndc, 1.0, 1.0);

    vec4 originWorld = camera.invViewProj * originClip;
    originWorld.xyz /= originWorld.w;

    vec4 targetWorld = camera.invViewProj * targetClip;
    targetWorld.xyz /= targetWorld.w;

    vec3 rayOrigin = originWorld.xyz;
    vec3 rayDir = normalize(targetWorld.xyz - originWorld.xyz);

    float tMin = 0.001;
    float tMax = 10000.0;

    rayQueryEXT primaryQuery;
    rayQueryInitializeEXT(
        primaryQuery, 
        topLevelAS, 
        gl_RayFlagsOpaqueEXT, 
        0xFF, 
        rayOrigin, 
        tMin, 
        rayDir, 
        tMax
    );

    while (rayQueryProceedEXT(primaryQuery)) {}

    float finalShadow = 1.0; 

 
    if (rayQueryGetIntersectionTypeEXT(primaryQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        
        float tHit = rayQueryGetIntersectionTEXT(primaryQuery, true);
        vec3 hitPos = rayOrigin + rayDir * tHit;
        vec3 lightDirection = normalize(-sceneLights.dirLight.direction.xyz);

     
        vec3 up = abs(lightDirection.z) < 0.999 ? vec3(0, 0, 1) : vec3(1, 0, 0);
        vec3 tangent = normalize(cross(up, lightDirection));
        vec3 bitangent = cross(lightDirection, tangent);

        float sunAngularSpread = 0.02; 
        float accumulatedShadow = 0.0;
        

        for(uint i = 0; i < pc.spp; i++) {
            
        
            uint seed = pixelCoord.x + pixelCoord.y * uint(resolution.x) + pc.frameCount * 719393 + i * 1337;

            float r = sqrt(rnd(seed)) * sunAngularSpread;
            float theta = rnd(seed) * 2.0 * PI;
            
            vec3 jitter = tangent * (cos(theta) * r) + bitangent * (sin(theta) * r);
            vec3 sampleDir = normalize(lightDirection + jitter);

            vec3 shadowOrigin = hitPos - (rayDir * 0.005) + (sampleDir * 0.005);

            rayQueryEXT shadowQuery;
            rayQueryInitializeEXT(
                shadowQuery, 
                topLevelAS, 
                gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 
                0xFF, 
                shadowOrigin, 
                0.001, 
                sampleDir, 
                1000.0
            );

            while (rayQueryProceedEXT(shadowQuery)) {}

            if (rayQueryGetIntersectionTypeEXT(shadowQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
                accumulatedShadow += 0.0; // In shadow
            } else {
                accumulatedShadow += 1.0; // Lit
            }
        }

        finalShadow = accumulatedShadow / float(pc.spp);
    }

    imageStore(shadowMaskImage, pixelCoord, vec4(finalShadow, 0.0, 0.0, 0.0));
}