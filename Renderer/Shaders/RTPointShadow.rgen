#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require

#include "Common/LightingHelpers.glsl"
#include "Common/CommonHelpers.glsl"

layout(location = 0) rayPayloadEXT float hitValue;

layout(set = 0, binding = 0) uniform CameraUBO {
    mat4 view;
    mat4 proj;
    mat4 invView;
    mat4 invProj;
    mat4 invViewProj;
    mat4 invProjUnjittered;
    mat4 viewProj;
    mat4 prevViewProj;
} camera;

layout(set = 1, binding = 0) uniform accelerationStructureEXT topLevelAS;

struct PointLight {
    vec4 position; // xyz = position, w = radius
    vec4 color;    // xyz = color,    w = luminance
};

struct DirectionalLight {
    vec4 direction;
    vec4 color;
};

layout(set = 0, binding = 3) readonly buffer LightData {
    DirectionalLight dirLight;
    uint pointLightCount;
    float padding[3];
    PointLight pointLights[];
} sceneLights;

layout(set = 2, binding = 0) uniform sampler2D samplerDepth;
layout(set = 2, binding = 1) uniform sampler2D samplerNormal;
layout(set = 2, binding = 2, r8) uniform writeonly image2DArray outPointShadowMask; 

layout(push_constant) uniform PushConsts {
    uint frameCount;
    uint spp;
} pc;

uint pcg_hash(uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rnd(inout uint seed) {
    seed = pcg_hash(seed);
    return float(seed) / 4294967296.0;
}

void main() 
{
    ivec2 pixelCoord = ivec2(gl_LaunchIDEXT.xy);
    vec2 resolution = vec2(gl_LaunchSizeEXT.xy);
    vec2 uv = (vec2(pixelCoord) + 0.5) / resolution;

    float depth = texture(samplerDepth, uv).r;

    if (depth >= 0.9999) {
        for (uint i = 0; i < sceneLights.pointLightCount; i++) {
            imageStore(outPointShadowMask, ivec3(pixelCoord, i), vec4(1.0));
        }
        return;
    }

    vec3 worldPos = reconstructWorldPos(depth, uv, camera.invViewProj);
    vec3 normal = normalize(texture(samplerNormal, uv).xyz);

    uint rayFlags = gl_RayFlagsTerminateOnFirstHitEXT | 
                    gl_RayFlagsOpaqueEXT | 
                    gl_RayFlagsSkipClosestHitShaderEXT;

    for (uint i = 0; i < sceneLights.pointLightCount; i++) {
        vec3 lightCenter = sceneLights.pointLights[i].position.xyz;
        float lightRadius = sceneLights.pointLights[i].position.w;
        
        vec3 fragToLightCenter = lightCenter - worldPos;
        float distanceToCenter = length(fragToLightCenter);

        if (distanceToCenter < 0.001) {
            imageStore(outPointShadowMask, ivec3(pixelCoord, i), vec4(1.0));
            continue;
        }

        vec3 centerDir = fragToLightCenter / distanceToCenter;
        float NoL = dot(normal, centerDir);

        if (NoL <= 0.0) {
            imageStore(outPointShadowMask, ivec3(pixelCoord, i), vec4(0.0));
            continue;
        }

        float accumulatedShadow = 0.0;

        for (uint s = 0; s < pc.spp; ++s) {

            uint seed = pixelCoord.x + pixelCoord.y * uint(resolution.x) + 
                        pc.frameCount * 719393 + i * 1337 + s * 9973;

 
            vec3 jitter = vec3(rnd(seed) * 2.0 - 1.0, 
                               rnd(seed) * 2.0 - 1.0, 
                               rnd(seed) * 2.0 - 1.0);
            
            jitter = normalize(jitter) * rnd(seed) * lightRadius;

            vec3 sampleLightPos = lightCenter + jitter;
            vec3 fragToSample = sampleLightPos - worldPos;
            float sampleDist = length(fragToSample);
            vec3 sampleDir = fragToSample / sampleDist;

            float normalBias = 0.002;
            float lightBias  = 0.005;
            vec3 origin = worldPos + (normal * normalBias) + (sampleDir * lightBias);

            hitValue = 0.0; // Default to shadowed

            traceRayEXT(
                topLevelAS,
                rayFlags,
                0xFF,
                0, 0, 0,
                origin,
                0.001,
                sampleDir,
                sampleDist, // Ray length reaches exactly to our sampled point
                0
            );

            accumulatedShadow += hitValue;
        }

        float finalShadow = accumulatedShadow / float(pc.spp);
        imageStore(outPointShadowMask, ivec3(pixelCoord, i), vec4(finalShadow));
    }
}