#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require

#include "Common/LightingHelpers.glsl"
#include "Common/CommonHelpers.glsl"

layout(location = 0) rayPayloadEXT float hitValue;

layout(set = 0, binding = 0) uniform CameraUBO {
    mat4 view;
    mat4 proj;
    mat4 invView;
    mat4 invProj;
    mat4 invViewProj;
    mat4 invProjUnjittered;
    mat4 viewProj;
    mat4 prevViewProj;
} camera;

layout(set = 1, binding = 0) uniform accelerationStructureEXT topLevelAS;

struct PointLight {
    vec4 position; // xyz = position, w = radius
    vec4 color;    // xyz = color,    w = luminance
};

struct DirectionalLight {
    vec4 direction;
    vec4 color;
};

layout(set = 0, binding = 3) readonly buffer LightData {
    DirectionalLight dirLight;
    uint pointLightCount;
    float padding[3];
    PointLight pointLights[];
} sceneLights;

layout(set = 2, binding = 0) uniform sampler2D samplerDepth;
layout(set = 2, binding = 1) uniform sampler2D samplerNormal;
layout(set = 2, binding = 2, r8) uniform writeonly image2DArray outPointShadowMask; 

void main() 
{
    ivec2 pixelCoord = ivec2(gl_LaunchIDEXT.xy);
    vec2 resolution = vec2(gl_LaunchSizeEXT.xy);
    vec2 uv = (vec2(pixelCoord) + 0.5) / resolution;

    float depth = texture(samplerDepth, uv).r;

    // Skybox clear
    if (depth >= 0.9999) {
        for (uint i = 0; i < sceneLights.pointLightCount; i++) {
            imageStore(outPointShadowMask, ivec3(pixelCoord, i), vec4(1.0));
        }
        return;
    }

    vec3 worldPos = reconstructWorldPos(depth, uv, camera.invViewProj);
    vec3 normal = normalize(texture(samplerNormal, uv).xyz);

    uint rayFlags = gl_RayFlagsTerminateOnFirstHitEXT | 
                    gl_RayFlagsOpaqueEXT | 
                    gl_RayFlagsSkipClosestHitShaderEXT;

    for (uint i = 0; i < sceneLights.pointLightCount; i++) {
        vec3 lightPos = sceneLights.pointLights[i].position.xyz;
        vec3 fragToLight = lightPos - worldPos;
        float distanceToLight = length(fragToLight);

        if (distanceToLight < 0.001) {
            imageStore(outPointShadowMask, ivec3(pixelCoord, i), vec4(1.0));
            continue;
        }

        vec3 lightDir = fragToLight / distanceToLight;
        float NoL = dot(normal, lightDir);

        if (NoL <= 0.0) {
            imageStore(outPointShadowMask, ivec3(pixelCoord, i), vec4(0.0));
            continue;
        }

        float normalBias = 0.002;
        float lightBias  = 0.005;
        vec3 origin = worldPos + (normal * normalBias) + (lightDir * lightBias);

        float tMin = 0.001;
        float tMax = distanceToLight;

        hitValue = 0.0;

        traceRayEXT(
            topLevelAS,
            rayFlags,
            0xFF,
            0,
            0,
            0,
            origin,
            tMin,
            lightDir,
            tMax,
            0
        );

        imageStore(outPointShadowMask, ivec3(pixelCoord, i), vec4(hitValue));
    }
}