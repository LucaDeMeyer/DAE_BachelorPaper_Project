#version 460

layout(local_size_x = 16, local_size_y = 16) in;

// --- Set 0: Global Data ---
layout(set = 0, binding = 0) uniform CameraUBO {
    mat4 view;
    mat4 proj;
    mat4 invView;
    mat4 invProj;
    mat4 invViewProj;
    mat4 invProjUnjittered;
    mat4 viewProj;
    mat4 prevViewProj;
} camera;


layout(set = 1, binding = 0) uniform sampler2D samplerRTR;
layout(set = 1, binding = 1) uniform sampler2D samplerDepth;
layout(set = 1, binding = 2) uniform sampler2D samplerNormal;
layout(set = 1, binding = 3) uniform sampler2D samplerMaterial;
layout(set = 1, binding = 4) uniform sampler2D samplerHistory;

layout(set = 1, binding = 5, rgba16f) uniform writeonly image2D outHistory; // Persistent storage
layout(set = 1, binding = 6, rgba16f) uniform writeonly image2D outGraph;   // Graph output


layout(push_constant) uniform Constants {
    int isRTAO;
} pc;

// Helper: Reconstruct World Position from Depth
vec3 ReconstructWorldPos(vec2 uv, float depth, mat4 invViewProj) {
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPos = invViewProj * clipPos;
    return worldPos.xyz / worldPos.w;
}

// Helper: Get Luminance for Variance calculation
float Luminance(vec3 color) {
    return dot(color, vec3(0.299, 0.587, 0.114));
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    vec2 size = vec2(imageSize(outGraph));
    
    if (pixelCoord.x >= size.x || pixelCoord.y >= size.y) return;

    vec2 uv = (vec2(pixelCoord) + 0.5) / size;

    // 1. Read Current Frame Data
    float depth = texture(samplerDepth, uv).r;
    
    // Skip the skybox
    if (depth >= 0.9999) {
        vec4 empty = vec4(0.0);
        imageStore(outHistory, pixelCoord, empty);
        imageStore(outGraph, pixelCoord, empty);
        return;
    }

    vec4 centerColor = texture(samplerRTR, uv);
    float roughness = texture(samplerMaterial, uv).g;

    // 2. Calculate 3x3 Neighborhood Mean and Variance
    vec3 m1 = vec3(0.0); // First moment (Mean)
    vec3 m2 = vec3(0.0); // Second moment (Variance prep)
    
    vec3 colorMin = vec3(9999.0);
    vec3 colorMax = vec3(-9999.0);

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec3 c = texture(samplerRTR, uv + vec2(x, y) / size).rgb;
            m1 += c;
            m2 += c * c;
            colorMin = min(colorMin, c);
            colorMax = max(colorMax, c);
        }
    }
    
    m1 /= 9.0;
    m2 /= 9.0;
    
    // Standard Variance Formula: E[X^2] - E[X]^2
    vec3 variance3 = abs(m2 - (m1 * m1)); 
    float localVariance = Luminance(variance3);

    // 3. Reproject to find the previous pixel coordinate
    vec3 worldPos = ReconstructWorldPos(uv, depth, camera.invViewProj);
    vec4 prevClip = camera.prevViewProj * vec4(worldPos, 1.0);
    vec2 prevUV = (prevClip.xy / prevClip.w) * 0.5 + 0.5;

    // 4. Sample History
    vec4 history = vec4(0.0);
    bool validHistory = (prevUV.x >= 0.0 && prevUV.x <= 1.0 && prevUV.y >= 0.0 && prevUV.y <= 1.0);
    
    if (validHistory) {
        history = texture(samplerHistory, prevUV);
        
        // Variance Clipping (Anti-Ghosting)
        // Clip the history color to the bounding box of our current 3x3 neighborhood.
        // This prevents old reflections from sticking to moving objects!
        history.rgb = clamp(history.rgb, colorMin, colorMax);
    }

    // 5. Accumulate!
    // Mix alpha based on how rough the surface is. 
    // Smooth surfaces accumulate slowly (0.05) to eliminate all noise.
    // Rougher surfaces adapt faster (0.2) because spatial blur handles them better anyway.
    float alpha;
    if (pc.isRTAO == 1) {
        alpha = validHistory ? 0.05 : 1.0; // AO is very noisy, accumulate heavily
    } else {
        // RTR uses roughness
        float roughness = texture(samplerMaterial, uv).g;
        // Early out for rough surfaces (saves performance for RTR)
       if (roughness > 0.4) {
            vec4 roughOut = vec4(centerColor.rgb, localVariance); // Use real local variance instead of 1.0!
            imageStore(outHistory, pixelCoord, roughOut);
            imageStore(outGraph, pixelCoord, roughOut);
            return;
        }
        alpha = validHistory ? mix(0.05, 0.2, roughness) : 1.0; 
    }

    vec3 accumulatedColor = mix(history.rgb, centerColor.rgb, alpha);
    
    // Mix the variance temporally so the spatial blur pass gets stable instructions
    float accumulatedVariance = mix(history.a, localVariance, alpha);

    // 6. Dual Write the result (RGB = Color, A = Variance)
    vec4 finalResult = vec4(accumulatedColor, accumulatedVariance);
    
    imageStore(outHistory, pixelCoord, finalResult); // Saves for next frame
    imageStore(outGraph, pixelCoord, finalResult);   // Sends to next graph pass
}