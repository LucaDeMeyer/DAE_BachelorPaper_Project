#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require

#include "Common/LightingHelpers.glsl"
#include "Common/CommonHelpers.glsl"

layout(location = 0) rayPayloadEXT float hitValue;

layout(set = 0, binding = 0) uniform CameraUBO {
    mat4 view;
    mat4 proj;
    mat4 invView;
    mat4 invProj;
    mat4 invViewProj;
    mat4 invProjUnjittered;
    mat4 viewProj;
    mat4 prevViewProj;
} camera;

layout(set = 1, binding = 0) uniform accelerationStructureEXT topLevelAS;

struct PointLight {
    vec4 position;
    vec4 color;
};

struct DirectionalLight {
    vec4 direction;
    vec4 color;
};

layout(set = 0, binding = 3) readonly buffer LightData {
    DirectionalLight dirLight;
    uint pointLightCount;
    float padding[3];
    PointLight pointLights[];
} sceneLights;

layout(set = 2, binding = 0) uniform sampler2D samplerDepth;
layout(set = 2, binding = 1) uniform sampler2D samplerNormal;
layout(set = 2, binding = 2, rgba16f) uniform writeonly image2D outShadowMask; 

layout(push_constant) uniform PushConsts {
    uint frameCount;
    uint spp;
} pc;


uint pcg_hash(uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rnd(inout uint seed) {
    seed = pcg_hash(seed);
    return float(seed) / 4294967296.0;
}

void main() 
{
    ivec2 pixelCoord = ivec2(gl_LaunchIDEXT.xy);
    vec2 resolution = vec2(gl_LaunchSizeEXT.xy);
    vec2 uv = (vec2(pixelCoord) + 0.5) / resolution;

    float depth = texture(samplerDepth, uv).r;

    if (depth >= 0.9999) {
        imageStore(outShadowMask, pixelCoord, vec4(1.0));
        return;
    }
    vec3 worldPos = reconstructWorldPos(depth, uv, camera.invViewProj);
    vec3 normal = normalize(texture(samplerNormal, uv).xyz);
    vec3 lightDir = normalize(-sceneLights.dirLight.direction.xyz);

    float NoL = dot(normal, lightDir);
    if (NoL <= 0.0) {

        imageStore(outShadowMask, pixelCoord, vec4(0.0));
        return;
    }
  
    float normalBias = 0.002; 
    float lightBias = 0.005;  
    
    vec3 origin = worldPos + (normal * normalBias) + (lightDir * lightBias);
 
    float tMin = 0.001; 
    float tMax = 1000.0;

    uint rayFlags = gl_RayFlagsTerminateOnFirstHitEXT | 
                    gl_RayFlagsOpaqueEXT | gl_RayFlagsSkipClosestHitShaderEXT;

    vec3 up = abs(lightDir.z) < 0.999 ? vec3(0, 0, 1) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(up, lightDir));
    vec3 bitangent = cross(lightDir, tangent);

    float sunAngularSpread = 0.02; 

    float accumulatedShadow = 0.0;

    for (uint i = 0; i < pc.spp; i++) {
        uint seed = pixelCoord.x + pixelCoord.y * uint(resolution.x) + pc.frameCount * 719393 + i * 1337;

        float r = sqrt(rnd(seed)) * sunAngularSpread;
        float theta = rnd(seed) * 2.0 * PI;

        vec3 jitter = tangent * (cos(theta) * r) + bitangent * (sin(theta) * r);
        vec3 sampleDir = normalize(lightDir + jitter);

        hitValue = 0.0;

        traceRayEXT(
            topLevelAS,    // The BVH
            rayFlags,      // Optimization flags
            0xFF,          // Cull mask 
            0,             // sbtRecordOffset
            0,             // sbtRecordStride
            0,             // missIndex 
            origin,        // Ray Origin
            tMin,          // Ray Min Distance
            sampleDir,     // Jittered Ray Direction
            tMax,          // Ray Max Distance
            0              // Payload Location 
        );

        accumulatedShadow += hitValue;
    }

    float finalShadow = accumulatedShadow / float(pc.spp);
    imageStore(outShadowMask, pixelCoord, vec4(finalShadow));
}