#version 460
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraUBO {
    mat4 view;
    mat4 proj;
    mat4 invView;
    mat4 invProj;
    mat4 invViewProj;
    mat4 invProjUnjittered;
    mat4 viewProj;
    mat4 prevViewProj;
} camera;

layout(set = 1, binding = 0) uniform sampler2DArray samplerInput;
layout(set = 1, binding = 1) uniform sampler2D samplerDepth;
layout(set = 1, binding = 2) uniform sampler2D samplerNormal;
layout(set = 1, binding = 3) uniform sampler2D samplerMaterial;
layout(set = 1, binding = 4) uniform sampler2DArray samplerHistory;
layout(set = 1, binding = 5, rgba16f) uniform writeonly image2DArray outHistory;
layout(set = 1, binding = 6, rgba16f) uniform writeonly image2DArray outGraph;

layout(push_constant) uniform Constants {
    int isRTAO;
} pc;

vec3 ReconstructWorldPos(vec2 uv, float depth, mat4 invViewProj) {
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPos = invViewProj * clipPos;
    return worldPos.xyz / worldPos.w;
}

float Luminance(vec3 color) {
    return dot(color, vec3(0.299, 0.587, 0.114));
}

void main() {
    ivec3 pixelCoord = ivec3(gl_GlobalInvocationID.xyz);
    vec2 size = vec2(imageSize(outGraph).xy);
    if (pixelCoord.x >= size.x || pixelCoord.y >= size.y) return;

    vec2 uv = (vec2(pixelCoord.xy) + 0.5) / size;
    float depth = texture(samplerDepth, uv).r;

    if (depth >= 0.9999) {
        vec4 empty = vec4(0.0);
        imageStore(outHistory, pixelCoord, empty);
        imageStore(outGraph, pixelCoord, empty);
        return;
    }

    vec4 centerColor = texture(samplerInput, vec3(uv, pixelCoord.z));

    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    vec3 colorMin = vec3(9999.0);
    vec3 colorMax = vec3(-9999.0);

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec3 c = texture(samplerInput, vec3(uv + vec2(x, y) / size, pixelCoord.z)).rgb;
            m1 += c;
            m2 += c * c;
            colorMin = min(colorMin, c);
            colorMax = max(colorMax, c);
        }
    }
    
    m1 /= 9.0;
    m2 /= 9.0;
    
    vec3 variance3 = abs(m2 - (m1 * m1));
    float localVariance = Luminance(variance3);

    vec3 worldPos = ReconstructWorldPos(uv, depth, camera.invViewProj);
    vec4 prevClip = camera.prevViewProj * vec4(worldPos, 1.0);
    vec2 prevUV = (prevClip.xy / prevClip.w) * 0.5 + 0.5;

    bool validHistory = (prevClip.w > 0.0) &&
                        (prevUV.x >= 0.0 && prevUV.x <= 1.0 &&
                         prevUV.y >= 0.0 && prevUV.y <= 1.0);

    vec4 history = vec4(0.0);
    if (validHistory) {
        history = texture(samplerHistory, vec3(prevUV, pixelCoord.z));
        if (any(isnan(history)) || any(isinf(history))) {
            history = vec4(0.0);
            validHistory = false;
        } else {
            history.rgb = clamp(history.rgb, colorMin, colorMax);
        }
    }

    float alpha = validHistory ? 0.05 : 1.0;

    vec3 accumulatedColor = mix(history.rgb, centerColor.rgb, alpha);
    float accumulatedVariance = mix(history.a, localVariance, alpha);
    vec4 finalResult = vec4(accumulatedColor, accumulatedVariance);

    imageStore(outHistory, pixelCoord, finalResult);
    imageStore(outGraph, pixelCoord, finalResult);
}