#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraUBO {
    mat4 view;
    mat4 proj;
    mat4 invView;
    mat4 invProj;
    mat4 invViewProj;
    mat4 invProjUnjittered;
    mat4 viewProj;
    mat4 prevViewProj;
} ubo;


layout(set = 1, binding = 0) uniform sampler2D inLighting;
layout(set = 1, binding = 1) uniform sampler2D inVelocity;
layout(set = 1, binding = 2) uniform sampler2D inDepth;
layout(set = 1, binding = 3) uniform sampler2D inHistory;

layout(set = 1, binding = 4, rgba16f) uniform writeonly image2D outTAA;
layout(set = 1, binding = 5, rgba16f) uniform writeonly image2D outHistory;


vec3 Reinhard(vec3 c) {
    return c / (1.0 + c);
}
vec3 InverseReinhard(vec3 c) {
    return c / max(vec3(1e-5), 1.0 - c);
}

void main()
{
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 texSize = textureSize(inLighting, 0);

    if (texelCoord.x >= texSize.x || texelCoord.y >= texSize.y) {
        return;
    }

    vec2 texelSize = 1.0 / vec2(texSize);
    vec2 uv = (vec2(texelCoord) + 0.5) * texelSize;

 
    vec2 velocity = texture(inVelocity, uv).rg;
    float closestDepth = texture(inDepth, uv).r;
    
    for(int y = -1; y <= 1; ++y) {
        for(int x = -1; x <= 1; ++x) {
            vec2 offsetUV = uv + vec2(x, y) * texelSize;
            float d = texture(inDepth, offsetUV).r;
            if(d < closestDepth) { 
                closestDepth = d;
                velocity = texture(inVelocity, offsetUV).rg;
            }
        }
    }
if (closestDepth >= 0.99999) {
        vec4 target = ubo.invProjUnjittered * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
        vec3 viewDir = target.xyz / target.w;
        
        vec3 worldDir = (ubo.invView * vec4(viewDir, 0.0)).xyz;
        
        vec4 prevClip = ubo.prevViewProj * vec4(worldDir, 0.0);
        vec2 prevNDC = prevClip.xy / prevClip.w;
        
        velocity = uv - (prevNDC * 0.5 + 0.5);
    }


    vec3 currentColor = texture(inLighting, uv).rgb;
    
    vec2 historyUV = uv - velocity;
    vec3 historyColor = texture(inHistory, historyUV).rgb;

    vec3 cMin = currentColor;
    vec3 cMax = currentColor;
   
    for(int y = -1; y <= 1; ++y) {
        for(int x = -1; x <= 1; ++x) {
            if(x == 0 && y == 0) continue;
            
            vec3 neighborColor = texture(inLighting, uv + vec2(x, y) * texelSize).rgb;
            cMin = min(cMin, neighborColor);
            cMax = max(cMax, neighborColor);
        }
    }

    historyColor = clamp(historyColor, cMin, cMax);

    float blendWeight = 0.1; 

   
    if (historyUV.x < 0.0 || historyUV.x > 1.0 || historyUV.y < 0.0 || historyUV.y > 1.0) {
        blendWeight = 1.0; 
    }


    vec3 ldrCurrent = Reinhard(currentColor);
    vec3 ldrHistory = Reinhard(historyColor);
    
    vec3 ldrFinal = mix(ldrHistory, ldrCurrent, blendWeight);
    vec3 finalColor = InverseReinhard(ldrFinal);
    if (any(isnan(finalColor)) || any(isinf(finalColor))) {
        finalColor = currentColor; 
    }
    imageStore(outTAA, texelCoord, vec4(finalColor, 1.0));
    imageStore(outHistory, texelCoord, vec4(finalColor, 1.0));
}